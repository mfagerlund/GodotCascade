/* Executed by CascadeDocument's focused GXML/GCSS vertical slice. */
.page {
    --page-padding-y: 56px;
    --page-padding-x: 80px;
    --section-gap: 24px;
    --surface: #0e1014;
    --accent: #7dbfff;
    --hero-height: 7vh;
    --card-padding: 20px 22px;
    --card-column-gap: 18px;
    min-height: 540px;
    padding: var(--page-padding-y) var(--page-padding-x);
    display: flex;
    flex-direction: column;
    gap: calc(var(--section-gap) * 1);
    background: var(--surface);
}

.heading {
    color: #dbe8ff;
    font-size: 30px;
}

.hero {
    height: calc(var(--hero-height) + 0px);
    padding: 8px 12px;
    background: linear-gradient(110deg, #162d50, #111827);
    border-radius: 9px;
}

.layout-badge {
    position: absolute;
    right: 0px;
    top: 2px;
    width: 112px;
    height: 28px;
    padding: 5px 8px;
    color: var(--accent);
    font-size: 12px;
    font-source: resource("res://examples/showcase/assets/cascade-mono-font.tres");
    opacity: 0.92;
    transform: translate(-2px, 2px) rotate(1deg);
    transform-origin: right top;
    background: #17253a;
    border: 1px solid #315a89;
    border-radius: 6px;
}

.lede {
    color: #9eacc7;
    font-size: 17px;
}

.cards {
    min-height: 230px;
    flex-grow: 1;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: minmax(210px, 1fr);
    column-gap: var(--card-column-gap);
}

.cards > .card {
    min-height: 210px;
    padding: var(--card-padding);
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #1b1f27;
    border: 1px solid #364561;
    border-radius: 10px;
}
.cards > .card:hover { background: #242b37; }

.card-title { font-size: 20px; }
.card-body { color: #b8c4db; font-size: 15px; flex-grow: 1; }
.card-image {
    width: 180px;
    height: 56px;
    object-fit: cover;
    border: 1px solid #315a89;
    border-radius: 6px;
}
.box-model .card-title { color: var(--accent); }
.flex-flow .card-title { color: #a8e08c; }
.godot-native .card-title { color: #ffb064; }

.actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
}

.status { color: var(--accent); flex-grow: 1; flex-shrink: 1; flex-basis: 240px; }
.inspected .status { color: #65d6a7; }
.inspection-note { color: #65d6a7; font-size: 11px; }

#inspect {
    min-width: 150px;
    min-height: 42px;
    padding: 9px 14px;
    background: #344054;
    color: #f2f4f7;
    border: 1px solid #667085;
    border-radius: 7px;
    flex-shrink: 0;
}

#inspect:hover { background: #475467; }
#inspect:pressed { background: #1d2939; }
#inspect:focused { border-color: #84adff; border-width: 2px; }
#inspect:disabled { background: #202938; color: #98a2b3; }

@media (max-width: 700px) {
    .page {
        --page-padding-y: 24px;
        --page-padding-x: 24px;
        --section-gap: 16px;
    }
    .cards {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto;
        row-gap: 12px;
    }
}
