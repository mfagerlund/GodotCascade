.leaderboard-page {
    min-height: 540px;
    padding: 30px 48px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #0a0f19;
}

.leaderboard-heading { display: flex; flex-direction: column; gap: 5px; }
.eyebrow { color: #7aa7ff; font-size: 11px; }
.title-row { display: flex; flex-direction: row; align-items: center; gap: 14px; }
.title { color: #f2f5fb; font-size: 30px; flex-grow: 1; }
.subtitle { color: #8d9bb5; font-size: 14px; }
.live-pill { min-width: 108px; padding: 6px 10px; background: #132b26; border: 1px solid #286452; border-radius: 99px; }
.live-text { color: #75e0b4; font-size: 10px; }

Table {
    grid-template-columns: 40px 54px minmax(140px, 1fr) minmax(100px, 0.7fr) 58px 76px 88px;
    column-gap: 0px;
    row-gap: 0px;
    background: #101827;
    border: 1px solid #2b3b57;
    border-radius: 12px;
    overflow: clip;
    flex-grow: 1;
}

TableHeaderCell {
    min-height: 38px;
    padding: 9px 12px;
    color: #8fa3c4;
    font-size: 11px;
    background: #172237;
    border: 0px solid #2b3b57;
}

TableCell {
    min-height: 44px;
    padding: 10px 12px;
    color: #d9e2f2;
    font-size: 14px;
    background: #101827;
    border: 1px solid #22314b;
}

.drag-cell { padding: 5px; }
.action-cell { padding: 5px; }
.drag-handle {
    min-width: 28px;
    min-height: 32px;
    padding: 4px 7px;
    color: #8fa3c4;
    background: #101827;
    border: 1px solid #314361;
    border-radius: 6px;
}
.drag-handle:hover { background: #1a2940; }
.remove-pilot {
    min-width: 76px;
    min-height: 32px;
    padding: 4px 8px;
    color: #f2b8b5;
    background: #24171d;
    border: 1px solid #66313c;
    border-radius: 6px;
}
.remove-pilot:hover { background: #382029; }

.leaderboard-footer { display: flex; flex-direction: row; align-items: center; gap: 16px; }
.status { color: #7f91af; font-size: 13px; flex-grow: 1; }
#add-pilot { min-width: 122px; min-height: 38px; background: #1c64d1; border: 1px solid #5aa7ff; border-radius: 8px; }
#add-pilot:hover { background: #2878e5; }
#add-pilot:pressed { background: #174fa5; }
.secondary-action { min-width: 122px; min-height: 38px; color: #c8d8f5; background: #142037; border: 1px solid #3b557e; border-radius: 8px; }
.secondary-action:hover { background: #1b2c49; }
.secondary-action:pressed { background: #101a2c; }
