<!-- Semantic table source paired with reference.html. -->
<Page class="leaderboard-page">
    <Column class="leaderboard-heading">
        <Label class="eyebrow">SEASON 12 · COMPETITIVE</Label>
        <Row class="title-row">
            <Label class="title">Flight leaderboard</Label>
            <Panel class="live-pill"><Label class="live-text">LIVE STANDINGS</Label></Panel>
        </Row>
        <Label class="subtitle">Add, remove, sort, or drag pilots while keyed rows reconcile in place.</Label>
    </Column>

    <Table id="leaderboard" accessible-label="Flight leaderboard">
        <TableHeader>
            <TableRow>
                <TableHeaderCell></TableHeaderCell>
                <TableHeaderCell>Rank</TableHeaderCell>
                <TableHeaderCell>Pilot</TableHeaderCell>
                <TableHeaderCell>Division</TableHeaderCell>
                <TableHeaderCell>Wins</TableHeaderCell>
                <TableHeaderCell>Rating</TableHeaderCell>
                <TableHeaderCell>Action</TableHeaderCell>
            </TableRow>
        </TableHeader>
        <TableBody>
            <Repeat items="{entries}" key="id">
                <TableRow class="pilot-row">
                    <TableCell class="drag-cell">
                        <Button class="drag-handle" accessible-label="Drag pilot to reorder">↕</Button>
                    </TableCell>
                    <TableCell class="rank-cell" text="{item.rank}" />
                    <TableCell class="pilot-cell" text="{item.pilot}" />
                    <TableCell text="{item.division}" />
                    <TableCell class="wins-cell" text="{item.wins}" />
                    <TableCell class="rating-cell" text="{item.rating}" />
                    <TableCell class="action-cell">
                        <Button class="remove-pilot" accessible-label="Remove pilot">Remove</Button>
                    </TableCell>
                </TableRow>
            </Repeat>
        </TableBody>
    </Table>

    <Row class="leaderboard-footer">
        <Label id="leaderboard-status" class="status" text="{status}" />
        <Button id="sort-rating" class="secondary-action" on-pressed="_on_sort_rating">Sort by rating</Button>
        <Button id="add-pilot" on-pressed="_on_add_pilot">Add pilot</Button>
    </Row>
</Page>
