{
  "version": 1,
  "title": "GodotCascade parity showcase",
  "description": "Executable HTML references and native GodotCascade output generated from paired demo sources against the current focused language subset.",
  "demos": [
    {
      "id": "layout-foundation",
      "title": "Layout foundation",
      "summary": "Reusable typed feature cards exercising custom properties, typed calc, flex basis/shrink, native opacity/transforms, gradients, custom fonts, slots, fractional grid tracks, and stack overlays.",
      "viewport": [960, 540],
      "html": "examples/showcase/layout_foundation/reference.html",
      "gxml": "examples/showcase/layout_foundation/interface.gxml",
      "gcss": "examples/showcase/layout_foundation/styles.gcss",
      "godot_scene": "examples/generated_showcase.tscn",
      "godot_screenshot": "docs/showcase/assets/layout-foundation-godot.png",
      "mappings": [
        ["<main>", "<Page>", "CascadeBox (column)"],
        ["display: grid", "<Grid>", "CascadeGrid track layout"],
        ["repeated card structure", "<Component> + typed Param + Slot", "Source-expanded native controls with scoped IDs"],
        ["1fr 1fr 1fr", "grid-template-columns", "Fractional track resolution"],
        [".cards > .card", ".cards > .card", "Direct-child selector matching"],
        ["@media (max-width: 700px)", "@media (max-width: 700px)", "Viewport-conditional recomputation"],
        ["7vh", "7vh", "Viewport-aware length resolution"],
        ["--accent / var()", "--accent / var()", "Cascaded, inherited custom-property resolution"],
        ["calc(var(--section-gap) * 1)", "calc(var(--section-gap) * 1)", "Typed length arithmetic before native application"],
        ["linear-gradient(110deg, …)", "linear-gradient(110deg, …)", "Rounded native two-stop gradient polygon"],
        ["flex-basis / flex-shrink", "flex-basis / flex-shrink", "Weighted main-axis shrink in the pure layout engine"],
        ["opacity / transform", "opacity / transform", "Canvas modulation plus container-safe Control offset transform"],
        ["font-family", "font-source: resource(…)", "Imported Godot Font resource with inherited native application"],
        ["position: absolute", "<Stack> + right/top", "Overlay inset placement"],
        ["visual media", "<Image src=\"res://…\">", "CascadeImage cover crop"],
        ["padding / gap", "padding / column-gap", "CascadeStyle + layout request"],
        ["card hover", ".cards > .card:hover", "Owned container hover adapter"],
        ["button click", "on-pressed=\"_on_inspect_layout\"", "Event-to-method binding"],
        ["state dependency inspection", "debugger binding/invalidation trace", "Targeted update or keyed-reconcile reason"],
        [":hover / :active", ":hover / :pressed", "Native button state drawing"]
      ]
    },
    {
      "id": "system-status",
      "title": "System status",
      "summary": "A compact game telemetry dashboard translating semantic browser progress elements into an owned, box-model-exact native Godot control.",
      "viewport": [960, 540],
      "html": "examples/showcase/system_status/reference.html",
      "gxml": "examples/showcase/system_status/interface.gxml",
      "gcss": "examples/showcase/system_status/styles.gcss",
      "godot_scene": "examples/system_status_showcase.tscn",
      "godot_screenshot": "docs/showcase/assets/system-status-godot.png",
      "mappings": [
        ["<progress value=\"72\">", "<Progress value=\"72\">", "CascadeProgress (Control)"],
        ["progress track", "background + border-radius", "CascadeStyle box painting"],
        ["::-webkit-progress-value", "fill-color", "Owned native fill drawing"],
        ["value / max", "value / max", "Clamped normalized range"],
        ["application data", "{telemetry.reserve}", "One-way property-path binding"],
        ["repeated status tags", "<Repeat items=\"{telemetry.tags}\" key=\"id\">", "Keyed collection reconciliation"],
        ["click handler", "on-pressed=\"_on_review_route\"", "Event-to-method signal binding"],
        ["nested flex panels", "Row / Column / Panel", "CascadeBox native layout"],
        ["<button>", "<Button>", "CascadeButton (BaseButton)"]
      ]
    },
    {
      "id": "settings-menu",
      "title": "Settings menu",
      "summary": "An interactive source-generated settings surface making two-way form write-back and dependent one-way refresh visible alongside native editing, validation, and owned controls.",
      "viewport": [960, 760],
      "html": "examples/showcase/settings_menu/reference.html",
      "gxml": "examples/showcase/settings_menu/interface.gxml",
      "gcss": "examples/showcase/settings_menu/styles.gcss",
      "godot_scene": "examples/settings_menu_showcase.tscn",
      "godot_screenshot": "docs/showcase/assets/settings-menu-godot.png",
      "shared_copy": [
        "GAME SETTINGS",
        "Graphics &amp; display",
        "Effects",
        "Profile",
        "Dynamic shadows",
        "Bloom",
        "Vertical sync",
        "Ray tracing · unavailable",
        "HUD channels",
        "Window mode",
        "Windowed",
        "Borderless",
        "Exclusive fullscreen",
        "UI scale",
        "Session notes",
        "LIVE BINDING MODEL",
        "Form write-back refreshes these one-way values immediately.",
        "QUALITY",
        "Low quality",
        "Medium quality",
        "High quality",
        "Ultra quality",
        "Apply settings"
      ],
      "source_parity": [
        {"label": "checkbox", "html": "type=\"checkbox\"", "gxml": "<Checkbox"},
        {"label": "text input", "html": "class=\"profile-input\"", "gxml": "<TextInput"},
        {"label": "writable text binding", "html": "id=\"profile-name\"", "gxml": "bind-text=\"{settings.profile}\""},
        {"label": "multiline text input", "html": "<textarea", "gxml": "multiline=\"true\""},
        {"label": "writable multiline binding", "html": "id=\"session-notes\"", "gxml": "bind-text=\"{settings.notes}\""},
        {"label": "repeated writable binding", "html": "data-repeat-scope=\"item.enabled\"", "gxml": "bind-checked=\"{item.enabled}\""},
        {"label": "switch", "html": "role=\"switch\"", "gxml": "<Switch"},
        {"label": "visible switch track", "html": "class=\"switch-track\"", "gxml": "<Switch"},
        {"label": "radio group", "html": "type=\"radio\"", "gxml": "<RadioButton"},
        {"label": "range slider", "html": "type=\"range\"", "gxml": "<Slider"},
        {"label": "visible range track", "html": "class=\"range-track\"", "gxml": "<Slider"},
        {"label": "select dropdown", "html": "<select", "gxml": "<Select"},
        {"label": "visible select face", "html": "class=\"select-face\"", "gxml": "<Select"},
        {"label": "validation", "html": "checkValidity()", "gxml": "required=\"true\""},
        {"label": "live range output", "html": "scaleValue.textContent", "gxml": "{ui.scale_label}"},
        {"label": "dependent binding output", "html": "id=\"bound-profile\"", "gxml": "text=\"{settings.profile}\""},
        {"label": "apply action", "html": "addEventListener('click'", "gxml": "on-pressed=\"_on_apply_settings\""}
      ],
      "mappings": [
        ["input[type=checkbox]", "Checkbox", "CascadeCheckbox (BaseButton toggle)"],
        ["input[type=text]", "TextInput", "CascadeTextInput (native LineEdit adapter)"],
        ["textarea", "TextInput multiline=\"true\"", "CascadeTextArea (native TextEdit adapter)"],
        ["input/change", "bind-*={path}", "Validated writable binding + dependent refresh"],
        ["live model output", "Label text={path}", "Immediate dependent one-way refresh"],
        ["repeated form rows", "Repeat + bind-checked={item.enabled}", "Keyed item-scope write-back"],
        ["input[role=switch]", "Switch", "CascadeSwitch track/thumb drawing"],
        ["select / option", "Select / Option", "CascadeSelect + PopupPanel"],
        ["input[type=range]", "Slider", "CascadeSlider native range input"],
        ["range hover", "#ui-scale:hover", "Native slider track hover state"],
        ["input[type=radio] name", "RadioButton group", "CascadeRadioButton + ButtonGroup"],
        ["checked / disabled", "checked / disabled", "Native button state"],
        [":checked / :hover", ":checked / :hover", "Shared state adapter"],
        [":invalid / :focus-visible", ":invalid / :focus-visible", "Validation and input-modality styling"],
        [":open / option:checked", ":open / Option:selected", "Popup and option state"],
        ["aria-label", "accessible-label", "Native accessibility name"],
        ["fieldset-like cards", "Panel + Column", "CascadePanel flex layout"]
      ]
    },
    {
      "id": "leaderboard",
      "title": "Flight leaderboard",
      "summary": "A semantic table that adds, removes, sorts, and drag-reorders keyed rows while preserving shared column tracks.",
      "viewport": [960, 540],
      "html": "examples/showcase/leaderboard/reference.html",
      "gxml": "examples/showcase/leaderboard/interface.gxml",
      "gcss": "examples/showcase/leaderboard/styles.gcss",
      "script": "examples/showcase/leaderboard/leaderboard_document.gd",
      "godot_scene": "examples/leaderboard_showcase.tscn",
      "godot_screenshot": "docs/showcase/assets/leaderboard-godot.png",
      "shared_copy": [
        "SEASON 12 · COMPETITIVE",
        "Flight leaderboard",
        "LIVE STANDINGS",
        "Add, remove, sort, or drag pilots while keyed rows reconcile in place.",
        "Rank",
        "Pilot",
        "Division",
        "Wins",
        "Rating",
        "Action",
        "Sort by rating",
        "Add pilot",
        "Remove"
      ],
      "source_parity": [
        {"label": "semantic table", "html": "<table aria-label=\"Flight leaderboard\">", "gxml": "<Table id=\"leaderboard\" accessible-label=\"Flight leaderboard\">"},
        {"label": "semantic header", "html": "<thead>", "gxml": "<TableHeader>"},
        {"label": "column headers", "html": "<th scope=\"col\">", "gxml": "<TableHeaderCell>"},
        {"label": "automatic scrolling", "html": "overflow:auto", "gxml": "<Scroll id=\"leaderboard-scroll\""},
        {"label": "keyed repeated rows", "html": "<tbody id=\"leaderboard-body\">", "gxml": "<Repeat items=\"{entries}\" key=\"id\">"},
        {"label": "shared columns", "html": "<colgroup>", "gxml": "<Table", "gcss": "grid-template-columns:"},
        {"label": "bound cells", "html": "Rhea Sol", "gxml": "text=\"{item.pilot}\""},
        {"label": "collection events", "html": "entries.splice", "gxml": "on-pressed=\"_on_add_pilot\""},
        {"label": "drag reorder", "html": "setPointerCapture", "gxml": "class=\"drag-handle\""}
      ],
      "mappings": [
        ["<table>", "<Table>", "CascadeTable shared track layout"],
        ["overflow: auto", "Scroll", "Native ScrollContainer viewport"],
        ["<thead> / <tbody>", "TableHeader / TableBody", "Semantic structural containers"],
        ["<tr>", "TableRow", "Shared row placement"],
        ["<th scope=col>", "TableHeaderCell", "Column-header accessibility metadata"],
        ["<td>", "TableCell", "Owned box/text cell"],
        ["<colgroup>", "grid-template-columns", "Fixed/fraction/minmax tracks"],
        ["tbody rows", "Repeat items={entries} key=id", "Keyed native row expansion"],
        ["cell text", "text={item.path}", "Scoped one-way binding"],
        ["add / remove", "Array mutation + renderRows()", "Typed model mutation + refresh_bindings()"],
        ["sort", "Array.sort()", "Array.sort_custom() + keyed reconciliation"],
        ["drag rows", "Captured pointer events", "Captured GUI input + stable item keys"]
      ]
    }
  ]
}
