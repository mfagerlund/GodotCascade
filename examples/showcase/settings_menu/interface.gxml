<!-- Executable settings-menu slice using owned native toggle controls. -->
<Page class="settings-page">
    <Column class="heading">
        <Label class="eyebrow">GAME SETTINGS</Label>
        <Label class="title">Graphics &amp; display</Label>
        <Label class="subtitle">Native focus, toggle, and radio-group behavior with Cascade-owned drawing.</Label>
    </Column>

    <Row class="settings-content">
        <Panel class="settings-card">
            <Label class="section-title">Effects</Label>
            <Label class="section-help">Tune visual features independently.</Label>
            <Row class="profile-setting">
                <Label class="profile-label">Profile</Label>
                <TextInput id="profile-name" bind-text="{settings.profile}" placeholder="Player name" required="true" pattern="^.{2,16}$" error-message="Enter 2–16 characters." accessible-label="Player profile name" />
            </Row>
            <Checkbox id="shadows" class="setting-option" bind-checked="{settings.shadows}" accessible-label="Enable dynamic shadows">Dynamic shadows</Checkbox>
            <Checkbox id="bloom" class="setting-option" bind-checked="{settings.bloom}" accessible-label="Enable bloom">Bloom</Checkbox>
            <Switch id="vsync" class="setting-option" bind-checked="{settings.vsync}" accessible-label="Enable vertical sync">Vertical sync</Switch>
            <Checkbox id="ray-tracing" class="setting-option" disabled="true" accessible-label="Ray tracing unavailable">Ray tracing · unavailable</Checkbox>
        </Panel>

        <Panel class="settings-card">
            <Label class="section-title">Window mode</Label>
            <Label class="section-help">Choose one native radio-group option.</Label>
            <RadioButton id="windowed" class="setting-option" group="window-mode">Windowed</RadioButton>
            <RadioButton id="borderless" class="setting-option" group="window-mode" checked="true">Borderless</RadioButton>
            <RadioButton id="fullscreen" class="setting-option" group="window-mode">Exclusive fullscreen</RadioButton>
            <Row class="scale-setting">
                <Label class="scale-label">UI scale</Label>
                <Slider id="ui-scale" min="75" max="125" bind-value="{settings.ui_scale}" step="5" accessible-label="Interface scale" />
                <Label class="scale-value" text="{ui.scale_label}" />
            </Row>
            <Label class="notes-label">Session notes</Label>
            <TextInput id="session-notes" multiline="true" bind-text="{settings.notes}" placeholder="Add notes for the next launch" max-length="160" accessible-label="Session notes" />
        </Panel>
    </Row>

    <Row class="settings-footer">
        <Label id="settings-status" class="hint" text="{ui.status}" />
        <Label class="select-label">QUALITY</Label>
        <Select id="quality" bind-selected="{settings.quality}" accessible-label="Graphics quality">
            <Option value="low">Low quality</Option>
            <Option value="medium">Medium quality</Option>
            <Option value="high">High quality</Option>
            <Option value="ultra">Ultra quality</Option>
        </Select>
        <Button id="apply" on-pressed="_on_apply_settings">Apply settings</Button>
    </Row>
</Page>
