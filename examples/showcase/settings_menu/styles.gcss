/* Source-native settings menu matching reference.html. */
.settings-page {
    min-height: 660px;
    padding: 34px 52px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: #0a0f19;
}

.heading { display: flex; flex-direction: column; gap: 6px; }
.eyebrow { color: #7dbfff; font-size: 12px; }
.title { color: #f1f5ff; font-size: 32px; }
.subtitle { color: #8d9bb5; font-size: 15px; }

.settings-content { display: flex; flex-direction: row; gap: 18px; flex-grow: 1; }
.settings-card {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    flex-grow: 1;
    background: #131b2a;
    border: 1px solid #2b3b57;
    border-radius: 14px;
}
.section-title { color: #f1f5ff; font-size: 20px; }
.section-help { color: #7f91af; font-size: 13px; margin-bottom: 5px; }
.profile-setting { min-height: 38px; display: flex; flex-direction: row; align-items: center; gap: 10px; }
.profile-label { min-width: 52px; color: #c9d5e9; font-size: 14px; }
#profile-name { min-width: 170px; min-height: 38px; flex-grow: 1; padding: 8px 11px; color: #f2f4f7; font-size: 14px; background: #101828; border: 1px solid #405477; border-radius: 7px; }
#profile-name:hover { background: #182235; }
#profile-name:focused { background: #131b2a; }
#profile-name:focus-visible { border-color: #84adff; border-width: 2px; }
#profile-name:invalid { background: #2a1720; color: #fff1f0; border-color: #f97066; }
.setting-option { min-height: 35px; color: #c9d5e9; font-size: 15px; border-radius: 7px; }
.setting-option:hover { background: #1d2939; }
.setting-option:pressed { background: #253b61; }
.setting-option:checked { background: #16233a; color: #ffffff; }
.setting-option:focused { border-color: #84adff; border-width: 2px; }
.setting-option:disabled { background: #111827; color: #667085; }
.scale-setting { min-height: 36px; display: flex; flex-direction: row; align-items: center; gap: 10px; margin-top: 5px; }
.scale-label { min-width: 58px; color: #c9d5e9; font-size: 14px; }
.scale-value { min-width: 38px; color: #8fa1bf; font-size: 13px; }
#ui-scale { min-width: 150px; height: 30px; flex-grow: 1; background: #344054; fill-color: #528bff; }
.notes-label { color: #c9d5e9; font-size: 14px; margin-top: 5px; }
#session-notes { min-height: 104px; padding: 9px 11px; color: #f2f4f7; font-size: 14px; background: #101828; border: 1px solid #405477; border-radius: 7px; }
#session-notes:hover { background: #182235; }
#session-notes:focused { background: #131b2a; }
#session-notes:focus-visible { border-color: #84adff; border-width: 2px; }
#session-notes:invalid { background: #2a1720; color: #fff1f0; border-color: #f97066; }

.settings-footer { display: flex; flex-direction: row; align-items: center; gap: 16px; }
.hint { color: #6f7f9b; font-size: 13px; flex-grow: 1; }
.select-label { color: #7f91af; font-size: 11px; }
#quality { min-width: 178px; min-height: 42px; background: #131b2a; border: 1px solid #405477; border-radius: 8px; }
#quality:hover { background: #1d2939; }
#quality:open { background: #253b61; }
Option { background: #101828; color: #d0d5dd; }
Option:hover { background: #1d2939; }
Option:selected { background: #16233a; color: #ffffff; }
#apply { min-width: 148px; min-height: 42px; background: #1c64d1; border: 1px solid #5aa7ff; border-radius: 8px; }
#apply:hover { background: #2878e5; }
#apply:pressed { background: #174fa5; }
#apply:focus-visible { border-color: #b7d2ff; border-width: 2px; }
